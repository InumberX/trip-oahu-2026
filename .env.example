# Build-time variables consumed by minista.config.ts via Vite's loadEnv.
# For local builds (`npm start`, `npm run deploy-*`), copy this file to
# `.env.development.local` or `.env.production.local` and fill in the values
# matching the target environment.
# CI builds inject these via GitHub Environment variables, so the .env files
# are only needed for local invocations of any script that bundles the site.

# 真偽値。development: true / production: false
# 'false' / '0' / 'no' / 'off' / 空 は false として扱う（plugins/env.ts）
NO_INDEX=
# development: https://dev-trip-oahu-2026.afterworks.jp
# production:  https://trip-oahu-2026.afterworks.jp
SITE_URL=
SITE_NAME=
GOOGLE_ANALYTICS_ID=
